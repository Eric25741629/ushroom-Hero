def get_stage_with_check(d, ip, Cnn_model, easyocr_reader):
    """
    ?? get_stage嚗????啁?炎?乓?    憒??潛?啣?駁?嚗?? LoginConflictError??    """
    stage = get_stage(d, Cnn_model, easyocr_reader)
    if stage == "?啣?駁?":
        logger.warning(f"[{ip}] ?典??菜葫?啁?啁??撘瑕?迫?")
        d.app_stop("com.mxdzz.tw.and")
        
        # 閮剖?銝活??????1 撠?敺?        wake_ts = time.time() + 3600
        wake_time_str = time.strftime("%H:%M", time.localtime(wake_ts))
        bot_state.update_state(ip, task="隡?銝?, step=f"?菜葫?啁?啁??(?? {wake_time_str} ??)", next_wake_at=wake_ts)
        
        # ??啣虜嚗?銝餉艘???脖蒂頝喳隡??挾
        raise LoginConflictError("?菜葫?啁?啁??)

    if stage == "??瘣餃?":
        logger.info(f"[{ip}] ?菜葫?啜?敺瘣餃???蝒?暺?蝛箇雿蔭??")
        click_white(d)
        time.sleep(1)
        
    return stage

