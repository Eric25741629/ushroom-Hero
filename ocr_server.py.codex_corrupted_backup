def strip_data_url(b64_str: str) -> str:
    # ?舀 data:image/png;base64,xxxx
    if not b64_str:
        return b64_str
    s = b64_str.strip()
    if s.lower().startswith("data:") and "," in s:
        return s.split(",", 1)[1]
    return s

